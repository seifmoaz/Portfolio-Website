# Notion internal integration token (from notion.so/my-integrations)
NOTION_TOKEN=

# Database IDs — copy from each database's URL in Notion.
# Share each database with the integration above before this will work.
NOTION_LOGOS_DB_ID=
NOTION_WORK_DB_ID=
NOTION_PHOTOGRAPHY_DB_ID=
NOTION_MOMENTS_DB_ID=

# Secret for the optional on-demand /api/revalidate route.
# Generate any random string, e.g. `openssl rand -hex 16`.
REVALIDATE_SECRET=
